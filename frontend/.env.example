# TMDb API-credentials
TMDB_API_KEY=""

# Intern adresse til FastAPI-backend (uvicorn) - brukes av server-til-
# server-kall fra PHP (f.eks. temp_add_movie_barcode/v1/submit.php).
# Bør peke internt (f.eks. http://172.19.0.1:9500), ikke via det
# offentlige domenet - gjør prosjektet enklere å flytte til en annen
# server/vert siden denne er den eneste stien som må endres.
MEDIA_API_BASE_URL="http://172.19.0.1:9500"

# Statisk nøkkel som backend (FastAPI) krever på enkelte lese-
# endepunkter (header X-API-Key). Må være IDENTISK med
# INTERNAL_API_KEY i backend/config/.env.
INTERNAL_API_KEY=""

# TVDb API-credentials
TVDB_API_KEY=""
TVDB_PIN=""

# Media-database (db_mediearkiv) - brukt av f.eks. website_template_example v15
# for å demonstrere lesing direkte fra databasen.
MEDIA_DB_HOST=""
MEDIA_DB_PORT="3306"
MEDIA_DB_NAME=""
MEDIA_DB_USER=""
MEDIA_DB_PASSWORD=""
