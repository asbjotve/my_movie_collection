# Generer en sikker nøkkel med: openssl rand -hex 32
SECRET_KEY=ENTER_YOUR_SECRET_KEY_HERE

# Statisk nøkkel som kreves (header X-API-Key) for å nå lese-endepunkter
# som ikke krever innlogget bruker. Samme nøkkel må settes i frontend
# sin .env. Generer med: openssl rand -hex 32
INTERNAL_API_KEY=ENTER_YOUR_INTERNAL_API_KEY_HERE

# Bruk enten full URL...
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mmc_userdb

# ...eller separate felter for brukerdatabasen:
# DB_USER=mmc_admin
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=mmc_userdb

# Mediedatabasen brukes av import-rutene:
# MEDIA_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/db_mediearkiv
# MEDIA_DB_USER=media_arkiv_admin
# MEDIA_DB_PASSWORD=your_password
# MEDIA_DB_HOST=127.0.0.1
# MEDIA_DB_PORT=3306
# MEDIA_DB_NAME=db_mediearkiv

# Kun brukt av /admin/restore-collection-data (restore fra SQL-dump-fil) -
# media_arkiv_admin over har bevisst KUN SELECT/INSERT/UPDATE/DELETE
# (least-privilege), men en restore kjører DROP/CREATE/ALTER som den
# brukeren ikke har rettigheter til. Opprett en egen DB-bruker scopet
# til db_mediearkiv.* med fulle rettigheter, og bruk den KUN her - se
# app/services/admin_backup.py.
# MEDIA_DB_RESTORE_USER=media_arkiv_restore
# MEDIA_DB_RESTORE_PASSWORD=your_restore_password

# Alternativt for SQLite:
# DATABASE_URL=sqlite:///./app.db
