# Generer en sikker nøkkel med: openssl rand -hex 32
SECRET_KEY=ENTER_YOUR_SECRET_KEY_HERE

# Bruk enten full URL...
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mmc_userdb

# ...eller separate felter for brukerdatabasen:
# DB_USER=mmc_admin
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=mmc_userdb

# Mediedatabasen brukes av import-rutene:
# MEDIA_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/db_mediearkiv
# MEDIA_DB_USER=media_arkiv_admin
# MEDIA_DB_PASSWORD=your_password
# MEDIA_DB_HOST=127.0.0.1
# MEDIA_DB_PORT=3306
# MEDIA_DB_NAME=db_mediearkiv

# Alternativt for SQLite:
# DATABASE_URL=sqlite:///./app.db
